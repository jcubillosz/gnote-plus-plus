<?xml version="1.0" encoding="UTF-8" ?>
<!-- Overlay propio del port macOS: estilos de lenguajes que el tema claro de
     Notepad++ (stylers.model.xml, symlink al árbol upstream) no define. Se
     consulta después del upstream, en cascada. -->
<NotepadPlus>
    <LexerStyles>
        <LexerType name="markdown" desc="Markdown" ext="">
            <WordsStyle name="DEFAULT" styleID="0" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="LINE BEGIN" styleID="1" fgColor="000000" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="STRONG 1" styleID="2" fgColor="000080" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="STRONG 2" styleID="3" fgColor="000080" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="EM 1" styleID="4" fgColor="800080" bgColor="FFFFFF" fontName="" fontStyle="2" fontSize="" />
            <WordsStyle name="EM 2" styleID="5" fgColor="800080" bgColor="FFFFFF" fontName="" fontStyle="2" fontSize="" />
            <WordsStyle name="HEADER 1" styleID="6" fgColor="000080" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="HEADER 2" styleID="7" fgColor="0000A0" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="HEADER 3" styleID="8" fgColor="0000C0" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="HEADER 4" styleID="9" fgColor="2020C0" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="HEADER 5" styleID="10" fgColor="4040C0" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="HEADER 6" styleID="11" fgColor="6060C0" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="PRECHAR" styleID="12" fgColor="808080" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="ULIST ITEM" styleID="13" fgColor="8000FF" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="OLIST ITEM" styleID="14" fgColor="8000FF" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="BLOCKQUOTE" styleID="15" fgColor="008000" bgColor="FFFFFF" fontName="" fontStyle="2" fontSize="" />
            <WordsStyle name="STRIKEOUT" styleID="16" fgColor="808080" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="HRULE" styleID="17" fgColor="804000" bgColor="FFFFFF" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="LINK" styleID="18" fgColor="0080C0" bgColor="FFFFFF" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="CODE" styleID="19" fgColor="800000" bgColor="EEEEEE" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="CODE 2" styleID="20" fgColor="800000" bgColor="EEEEEE" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="CODE BLOCK" styleID="21" fgColor="800000" bgColor="EEEEEE" fontName="" fontStyle="0" fontSize="" />
        </LexerType>
    </LexerStyles>
</NotepadPlus>
