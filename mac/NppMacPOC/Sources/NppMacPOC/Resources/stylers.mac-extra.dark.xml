<?xml version="1.0" encoding="UTF-8" ?>
<!-- Overlay propio del port macOS: estilos de lenguajes que el tema oscuro de
     Notepad++ (DarkModeDefault.xml, symlink al árbol upstream) no define. Se
     consulta después del upstream, en cascada. Paleta VSCode Dark+, coherente
     con VSCodeDarkPlus.xml. Todo el texto suelto comparte el bgColor del
     editor (1E1E1E) — solo los bloques de código llevan un fondo propio,
     ligeramente más claro, para diferenciarse. -->
<NotepadPlus>
    <LexerStyles>
        <LexerType name="markdown" desc="Markdown" ext="">
            <WordsStyle name="DEFAULT" styleID="0" fgColor="D4D4D4" bgColor="1E1E1E" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="LINE BEGIN" styleID="1" fgColor="D4D4D4" bgColor="1E1E1E" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="STRONG 1" styleID="2" fgColor="D4D4D4" bgColor="1E1E1E" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="STRONG 2" styleID="3" fgColor="D4D4D4" bgColor="1E1E1E" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="EM 1" styleID="4" fgColor="D4D4D4" bgColor="1E1E1E" fontName="" fontStyle="2" fontSize="" />
            <WordsStyle name="EM 2" styleID="5" fgColor="D4D4D4" bgColor="1E1E1E" fontName="" fontStyle="2" fontSize="" />
            <WordsStyle name="HEADER 1" styleID="6" fgColor="569CD6" bgColor="1E1E1E" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="HEADER 2" styleID="7" fgColor="569CD6" bgColor="1E1E1E" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="HEADER 3" styleID="8" fgColor="569CD6" bgColor="1E1E1E" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="HEADER 4" styleID="9" fgColor="569CD6" bgColor="1E1E1E" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="HEADER 5" styleID="10" fgColor="569CD6" bgColor="1E1E1E" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="HEADER 6" styleID="11" fgColor="569CD6" bgColor="1E1E1E" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="PRECHAR" styleID="12" fgColor="808080" bgColor="1E1E1E" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="ULIST ITEM" styleID="13" fgColor="DCDCAA" bgColor="1E1E1E" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="OLIST ITEM" styleID="14" fgColor="DCDCAA" bgColor="1E1E1E" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="BLOCKQUOTE" styleID="15" fgColor="6A9955" bgColor="1E1E1E" fontName="" fontStyle="2" fontSize="" />
            <WordsStyle name="STRIKEOUT" styleID="16" fgColor="808080" bgColor="1E1E1E" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="HRULE" styleID="17" fgColor="808080" bgColor="1E1E1E" fontName="" fontStyle="1" fontSize="" />
            <WordsStyle name="LINK" styleID="18" fgColor="569CD6" bgColor="1E1E1E" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="CODE" styleID="19" fgColor="CE9178" bgColor="2D2D2D" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="CODE 2" styleID="20" fgColor="CE9178" bgColor="2D2D2D" fontName="" fontStyle="0" fontSize="" />
            <WordsStyle name="CODE BLOCK" styleID="21" fgColor="CE9178" bgColor="2D2D2D" fontName="" fontStyle="0" fontSize="" />
        </LexerType>
    </LexerStyles>
</NotepadPlus>
